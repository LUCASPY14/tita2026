# URL del backend Django para el proxy de desarrollo (Vite dev server).
# No afecta la build de producción — en producción Nginx hace el proxy en el mismo origen.
# Copiar como .env.development.local para sobreescribir el valor por defecto.
VITE_BACKEND_URL=http://localhost:8000

# Sentry (opcional — dejar vacío para deshabilitar).
# Obtener DSN en: https://sentry.io → Settings → Projects → <proyecto> → Client Keys
VITE_SENTRY_DSN=
# SHA del commit de git (se rellena automáticamente en CI con: git rev-parse HEAD)
VITE_GIT_COMMIT_SHA=
