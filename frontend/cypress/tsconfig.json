{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["ES2017", "dom"],
    "types": ["cypress"],
    "moduleResolution": "node",
    "skipLibCheck": true,
    "strict": false,
    "allowJs": true,
    "esModuleInterop": true
  },
  "include": [
    "**/*.ts",
    "support/*.ts"
  ],
  "exclude": [
    "../node_modules"
  ]
}