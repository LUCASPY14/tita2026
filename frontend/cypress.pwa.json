{
  "e2e": {
    "specPattern": "cypress/e2e/pwa/**/*.cy.{js,jsx,ts,tsx}",
    "supportFile": "cypress/support/e2e.ts",
    "viewportWidth": 1280,
    "viewportHeight": 720,
    "video": true,
    "screenshotsFolder": "cypress/screenshots/pwa",
    "videosFolder": "cypress/videos/pwa",
    "env": {
      "PWA_TEST_MODE": true,
      "ENABLE_SERVICE_WORKER": true
    },
    "retries": {
      "runMode": 2,
      "openMode": 0
    },
    "defaultCommandTimeout": 10000,
    "requestTimeout": 15000,
    "responseTimeout": 15000,
    "pageLoadTimeout": 30000
  }
}