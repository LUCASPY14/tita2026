# ===================================
# CANTINA TITA — Variables de Entorno
# ===================================
# Copiar este archivo a .env y completar los valores reales.
# NUNCA versionar el archivo .env con credenciales reales.
#
# Para generar un SECRET_KEY seguro:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

# --- GENERAL ---
DEBUG=False
# Reemplazar con una clave generada aleatoriamente (≥50 caracteres)
SECRET_KEY=CAMBIAR-POR-CLAVE-SEGURA-GENERADA-CON-secrets.token_urlsafe

# Hosts separados por coma. En producción: tu dominio real
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes CORS permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- BASE DE DATOS SQL SERVER ---
DB_NAME=titadb
DB_USER=sa
DB_PASSWORD=CAMBIAR-POR-PASSWORD-SEGURO
MSSQL_SA_PASSWORD=CAMBIAR-POR-PASSWORD-SA-SEGURO
MSSQL_PID=Developer
DB_HOST=db
DB_PORT=1433

# --- REDIS ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CAMBIAR-POR-PASSWORD-SEGURO

# --- PUERTOS EXPUESTOS ---
BACKEND_PORT=8000
NGINX_PORT=80
NGINX_SSL_PORT=443

# --- CELERY ---
# Actualizar con el REDIS_PASSWORD correcto
CELERY_BROKER_URL=redis://:REDIS_PASSWORD@redis:6379/0
CELERY_RESULT_BACKEND=redis://:REDIS_PASSWORD@redis:6379/0

# --- EMAIL (OPCIONAL) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
