# ──────────────────────────────────────────────────────────────────────────────
# Cantina Tita — Variables de entorno
# Copiar este archivo a .env y completar los valores reales.
# NUNCA commitear el archivo .env con datos reales.
# ──────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Base de datos (PostgreSQL) ────────────────────────────────────────────────
DB_NAME=cantina_tita_dev
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
# URL de conexión a Redis (para Celery broker y cache opcional)
REDIS_URL=redis://localhost:6379/0

# Activar Redis como backend de caché Django (True / False)
USE_REDIS_CACHE=False

# Activar Redis como backend de WebSocket Channels (True / False)
# Recomendado en producción o cuando hay múltiples workers
USE_REDIS_CHANNELS=False

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Email SMTP ────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Cantina Tita <noreply@cantinatita.com>

# ── Portal de padres ──────────────────────────────────────────────────────────
PORTAL_FRONTEND_URL=http://localhost:5173

# ── Notificaciones ────────────────────────────────────────────────────────────
NOTIFICACIONES_ACTIVAS=True
NOTIFICACION_SALDO_BAJO=10000
NOTIFICACION_INTERVALO=24

# ── SIPAP (Pagos QR Paraguay) ─────────────────────────────────────────────────
SIPAP_AMBIENTE=sandbox
SIPAP_MERCHANT_ID=
SIPAP_API_KEY=
SIPAP_API_SECRET=
SIPAP_BANCO_AGREGADOR=
SIPAP_QR_EXPIRACION_MINUTOS=15

# ── Admins (reciben alertas de tareas Celery críticas) ────────────────────────
# Formato: Nombre:email,Nombre2:email2
# ADMINS=Admin:admin@cantinatita.com

# ── Sentry (monitoreo de errores en producción) ────────────────────────────────
# Obtener el DSN en sentry.io → Settings → Projects → <project> → Client Keys
SENTRY_DSN=
# Identifica el entorno en Sentry (production / staging)
SENTRY_ENVIRONMENT=production
# Release: usar el SHA del commit o la versión de la app
SENTRY_RELEASE=
# Fracción de transacciones que se rastrean para performance (0.0 – 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1
# Fracción de profiles de CPU (requiere traces activo)
SENTRY_PROFILES_SAMPLE_RATE=0.05
