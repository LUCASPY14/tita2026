# Django Settings
DJANGO_ENVIRONMENT=development
DJANGO_SECRET_KEY=django-insecure-cantina-tita-2026-change-this-in-production

# Database Configuration
DB_ENGINE=mssql
DB_NAME=titadb
DB_USER=sa
DB_PASSWORD=ChangeThis_StrongPassw0rd!
DB_HOST=localhost
DB_PORT=1433

# CORS Settings
ALLOWED_HOSTS=localhost,127.0.0.1

# Email Configuration (Producción)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ==============================================================================
# SIPAP Configuration (Sistema de Pagos QR - Banco Central del Paraguay)
# ==============================================================================

# Ambiente: 'sandbox' para testing, 'produccion' para operación real
SIPAP_AMBIENTE=sandbox

# Credenciales del comercio (obtener del banco agregador)
SIPAP_MERCHANT_ID=
SIPAP_API_KEY=
SIPAP_API_SECRET=

# Banco agregador: continental, atlas, itau, gnb, bcp, etc.
SIPAP_BANCO_AGREGADOR=continental

# Clave pública RSA del banco para validar webhooks (PEM format)
# Obtener del banco agregador al momento de contratar
SIPAP_BANCO_PUBLIC_KEY=

# NOTA: En producción actualizar con IPs reales del banco
# Ejemplo: SIPAP_IP_WHITELIST=190.105.242.1,190.105.242.2,190.105.242.3
