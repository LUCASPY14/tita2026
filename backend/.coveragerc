[coverage:run]
source = apps
omit =
    */management/commands/*
    */admin.py
    */migrations/*
    */tests/*
    */test_*.py

[coverage:report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if TYPE_CHECKING:
omit =
    */management/commands/*
    */admin.py
    */migrations/*
    */tests/*
    */test_*.py
