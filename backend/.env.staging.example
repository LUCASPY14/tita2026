# ==========================================
# CANTINA TITA - STAGING ENVIRONMENT
# ==========================================
# Copiar a .env.staging y completar con valores reales.
# DO NOT commit .env.staging to git.
#
# Diferencias clave vs producción:
#   - DB_NAME=cantina_tita_staging
#   - BANCARD_SANDBOX=True  (sandbox de Bancard)
#   - ALLOWED_HOSTS incluye :8080
#   - SECRET_KEY distinta a producción
#
# Prerequisito: crear la DB antes de levantar staging:
#   psql -U postgres -c "CREATE DATABASE cantina_tita_staging OWNER app_cantina;"

# ==========================================
# DJANGO CORE
# ==========================================

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=<STAGING_SECRET_KEY_DISTINTA_A_PRODUCCION>

DJANGO_SETTINGS_MODULE=backend.settings.production

DEBUG=False

ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100

CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://192.168.1.100:8080

CORS_ALLOWED_ORIGINS=http://localhost:8080,http://192.168.1.100:8080

# ==========================================
# DATABASE (PostgreSQL — staging DB)
# ==========================================

DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=cantina_tita_staging
DB_USER=app_cantina
DB_PASSWORD=<MISMO_PASSWORD_QUE_PRODUCCION>

# ==========================================
# EMAIL
# ==========================================

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@cantinatita.com
EMAIL_HOST_PASSWORD=<EMAIL_PASSWORD>
DEFAULT_FROM_EMAIL=noreply+staging@cantinatita.com
ADMIN_EMAIL=admin@cantinatita.com

# ==========================================
# REDIS
# ==========================================

REDIS_URL=redis://redis:6379/1
USE_REDIS_CACHE=True
USE_REDIS_CHANNELS=True

# ==========================================
# CELERY
# ==========================================

CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ==========================================
# BANCARD — SANDBOX (obligatorio en staging)
# ==========================================

BANCARD_PUBLIC_KEY=<BANCARD_SANDBOX_PUBLIC_KEY>
BANCARD_PRIVATE_KEY=<BANCARD_SANDBOX_PRIVATE_KEY>
BANCARD_SANDBOX=True
BANCARD_RETURN_URL=http://localhost:8080/portal/pago/retorno/

PORTAL_FRONTEND_URL=http://localhost:8080

# ==========================================
# NOTIFICACIONES
# ==========================================

NOTIFICACIONES_ACTIVAS=False

WAHA_URL=http://waha:3001
WAHA_API_KEY=<WAHA_API_KEY>

VAPID_PRIVATE_KEY=<VAPID_PRIVATE_KEY>
VAPID_PUBLIC_KEY=<VAPID_PUBLIC_KEY>
VAPID_ADMIN_EMAIL=admin@cantinatita.com

# ==========================================
# SENTRY (opcional en staging)
# ==========================================

SENTRY_DSN=
