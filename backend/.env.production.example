# ==========================================
# CANTINA TITA - PRODUCTION ENVIRONMENT
# ==========================================
# Copy this file to .env.production and fill with real values
# DO NOT commit .env.production to git!

# ==========================================
# DJANGO CORE
# ==========================================

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=RznXrhcUewXXf_hyaMZpOdfVfAI6hIE2cB5q7ERa6YPSkNsj0gkuB_gA8xNL2M6Zm7w

DJANGO_SETTINGS_MODULE=backend.settings.production

DEBUG=False

ALLOWED_HOSTS=cantina-tita.com,www.cantina-tita.com,api.cantina-tita.com

CSRF_TRUSTED_ORIGINS=https://cantina-tita.com,https://www.cantina-tita.com

CORS_ALLOWED_ORIGINS=https://cantina-tita.com,https://www.cantina-tita.com

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=cantina_tita
DB_USER=app_cantina
DB_PASSWORD=<STRONG_PASSWORD_HERE>
# El usuario app_cantina ya existe en la instancia dev con privilegios mínimos (DML solo).
# En una instancia nueva: psql -U postgres -f scripts/setup_db_user.sql

# ==========================================
# EMAIL CONFIGURATION
# ==========================================

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@cantina-tita.com
EMAIL_HOST_PASSWORD=<EMAIL_PASSWORD_HERE>
DEFAULT_FROM_EMAIL=noreply@cantina-tita.com
ADMIN_EMAIL=admin@cantina-tita.com

# ==========================================
# REDIS (OPTIONAL - for caching)
# ==========================================

REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=<REDIS_PASSWORD_HERE>

# ==========================================
# CELERY WORKER
# ==========================================
# Tareas son I/O-bound (DB + email): 4 workers cubre 14 tareas periódicas
# y los dos pares que corren cada 15 min en paralelo sin saturar CPU.
# Bajar a 2 en PCs con <4GB RAM; subir a 8 solo si el disco/DB aguanta.
CELERY_CONCURRENCY=4

# ==========================================
# BANCARD — Pagos con tarjeta Visa/Mastercard
# ==========================================
# IMPORTANTE: BANCARD_SANDBOX=False en producción (production.py lo fuerza,
# pero es buena práctica dejarlo explícito aquí también)
BANCARD_SANDBOX=False
BANCARD_PUBLIC_KEY=<PUBLIC_KEY_DE_BANCARD>
BANCARD_PRIVATE_KEY=<PRIVATE_KEY_DE_BANCARD>
BANCARD_MERCHANT_ID=<MERCHANT_ID_DE_BANCARD>
BANCARD_RETURN_URL=https://cantina-tita.com/pago/retorno
BANCARD_CANCEL_URL=https://cantina-tita.com/pago/cancelado

# ==========================================
# SENTRY (OPTIONAL - for error tracking)
# ==========================================

SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
GIT_COMMIT_SHA=$(git rev-parse HEAD)

# ==========================================
# PORTAL DE PADRES
# ==========================================

# URL pública del frontend — usada por bancard_views.py para redirigir
# al portal tras el pago (retorno/cancelación desde Bancard)
PORTAL_FRONTEND_URL=https://cantina-tita.com

# ==========================================
# GRAFANA
# ==========================================

# Contraseña del usuario admin de Grafana (default: tita2026)
GRAFANA_PASSWORD=<GRAFANA_ADMIN_PASSWORD>
