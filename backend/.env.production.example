# ==========================================
# CANTINA TITA - PRODUCTION ENVIRONMENT
# ==========================================
# Copy this file to .env.production and fill with real values
# DO NOT commit .env.production to git!

# ==========================================
# DJANGO CORE
# ==========================================

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=RznXrhcUewXXf_hyaMZpOdfVfAI6hIE2cB5q7ERa6YPSkNsj0gkuB_gA8xNL2M6Zm7w

DJANGO_SETTINGS_MODULE=backend.settings.production

DEBUG=False

# Agregar también la IP LAN del servidor (ej. 192.168.1.100) para que las PCs internas accedan sin DNS
ALLOWED_HOSTS=cantinatita.com,www.cantinatita.com,192.168.1.100,localhost

CSRF_TRUSTED_ORIGINS=https://cantinatita.com,https://www.cantinatita.com

CORS_ALLOWED_ORIGINS=https://cantinatita.com,https://www.cantinatita.com

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=cantina_tita
DB_USER=app_cantina
DB_PASSWORD=<STRONG_PASSWORD_HERE>
# El usuario app_cantina ya existe en la instancia dev con privilegios mínimos (DML solo).
# En una instancia nueva: psql -U postgres -f scripts/setup_db_user.sql

# ==========================================
# EMAIL CONFIGURATION
# ==========================================

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@cantinatita.com
EMAIL_HOST_PASSWORD=<EMAIL_PASSWORD_HERE>
DEFAULT_FROM_EMAIL=noreply@cantinatita.com
ADMIN_EMAIL=admin@cantinatita.com

# ==========================================
# REDIS
# ==========================================

REDIS_URL=redis://redis:6379/0

# Activar caché Redis (recomendado en producción — requiere django-redis)
USE_REDIS_CACHE=True
# Activar Channel Layer Redis para WebSockets (recomendado en producción)
USE_REDIS_CHANNELS=True

# ==========================================
# CELERY WORKER
# ==========================================
# Tareas son I/O-bound (DB + email): 4 workers cubre 14 tareas periódicas
# y los dos pares que corren cada 15 min en paralelo sin saturar CPU.
# Bajar a 2 en PCs con <4GB RAM; subir a 8 solo si el disco/DB aguanta.
CELERY_CONCURRENCY=4

# ==========================================
# BANCARD — Pagos con tarjeta Visa/Mastercard
# ==========================================
# IMPORTANTE: BANCARD_SANDBOX=False en producción (production.py lo fuerza,
# pero es buena práctica dejarlo explícito aquí también)
BANCARD_SANDBOX=False
BANCARD_PUBLIC_KEY=<PUBLIC_KEY_DE_BANCARD>
BANCARD_PRIVATE_KEY=<PRIVATE_KEY_DE_BANCARD>
BANCARD_MERCHANT_ID=<MERCHANT_ID_DE_BANCARD>
BANCARD_RETURN_URL=https://cantinatita.com/pago/retorno
BANCARD_CANCEL_URL=https://cantinatita.com/pago/cancelado

# ==========================================
# SENTRY — Requerido en producción (production.py lanza error si falta)
# Crear cuenta en https://sentry.io (plan gratuito: 5.000 errores/mes)
# Crear DOS proyectos: uno Django (backend) y uno React (frontend)
# Obtener cada DSN en: Settings → Projects → <proyecto> → Client Keys (DSN)
# ==========================================

# DSN del proyecto Django (backend)
SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
SENTRY_ENVIRONMENT=production
# Porcentaje de requests con tracing de performance (0.0 - 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1
# Porcentaje de requests con profiling (0.0 - 1.0)
SENTRY_PROFILES_SAMPLE_RATE=0.05
# Setear en el deploy: GIT_COMMIT_SHA=$(git rev-parse HEAD) >> backend/.env.production

# DSN del proyecto React (frontend) — deploy.ps1 lo pasa como VITE_SENTRY_DSN al build de Docker
SENTRY_DSN_FRONTEND=https://<key2>@<org>.ingest.sentry.io/<project2>

# ==========================================
# WEB PUSH (VAPID) — Notificaciones push PWA
# Generar claves con: pip install pywebpush && vapid --applicationServerKey
# ==========================================

VAPID_PUBLIC_KEY=<BASE64URL_PUBLIC_KEY>
VAPID_PRIVATE_KEY=<BASE64URL_PRIVATE_KEY>
VAPID_ADMIN_EMAIL=admin@cantinatita.com

# ==========================================
# PORTAL DE PADRES
# ==========================================

# URL pública del frontend — usada por bancard_views.py para redirigir
# al portal tras el pago (retorno/cancelación desde Bancard)
PORTAL_FRONTEND_URL=https://cantinatita.com

# ==========================================
# WHATSAPP (WAHA — self-hosted)
# Instalar con: docker run -d --name waha -p 3000:3000 devlikeapro/waha:latest
# ==========================================

# URL base de WAHA (si corre en el mismo servidor, usar el nombre del contenedor o la IP LAN)
EVOLUTION_API_URL=http://192.168.1.100:3000
# API key de WAHA (configurar en WAHA_API_KEY al arrancar el contenedor)
EVOLUTION_API_KEY=<WAHA_API_KEY>
# Nombre de la sesión/instancia de WhatsApp (default: default)
EVOLUTION_API_INSTANCE=default
# Activar envío de notificaciones por WhatsApp y alertas
NOTIFICACIONES_ACTIVAS=True

# ==========================================
# PROMETHEUS PUSHGATEWAY
# ==========================================

# URL interna del PushGateway (usa el nombre del servicio Docker)
PUSHGATEWAY_URL=http://pushgateway:9091

# ==========================================
# GRAFANA
# ==========================================

# Contraseña del usuario admin de Grafana (default: tita2026)
GRAFANA_PASSWORD=<GRAFANA_ADMIN_PASSWORD>
