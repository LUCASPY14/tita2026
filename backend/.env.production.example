# ==========================================
# CANTINA TITA - PRODUCTION ENVIRONMENT
# ==========================================
# Copiar este archivo a .env.production y completar con valores reales.
# NO commitear .env.production a git.

# ==========================================
# DJANGO CORE
# ==========================================

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=<GENERAR_CON_COMANDO_ARRIBA>

DJANGO_SETTINGS_MODULE=backend.settings.production

DEBUG=False

# Incluir siempre: dominio público, IP LAN del servidor, localhost y 'backend'
# 'backend' es necesario para que Prometheus pueda scrapear /metrics
ALLOWED_HOSTS=cantinatita.com,www.cantinatita.com,192.168.1.100,localhost,backend

CSRF_TRUSTED_ORIGINS=https://cantinatita.com,https://www.cantinatita.com

CORS_ALLOWED_ORIGINS=https://cantinatita.com,https://www.cantinatita.com

# ==========================================
# DATABASE (PostgreSQL en Docker)
# ==========================================
# DB_HOST no va aquí — se inyecta como 'postgres' (nombre del servicio Docker)
# desde docker-compose.yml para no duplicar configuración de infra.

DB_NAME=cantina_tita
DB_USER=app_cantina
DB_PASSWORD=<CONTRASEÑA_FUERTE_AQUI>

# ==========================================
# EMAIL
# ==========================================

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@cantinatita.com
EMAIL_HOST_PASSWORD=<EMAIL_PASSWORD_AQUI>
DEFAULT_FROM_EMAIL=noreply@cantinatita.com
ADMIN_EMAIL=admin@cantinatita.com

# ==========================================
# REDIS
# ==========================================
# DB 1 reservada para Django (Channels + cache).
# DB 0 queda libre para uso futuro o herramientas externas.
REDIS_URL=redis://redis:6379/1

USE_REDIS_CACHE=True
USE_REDIS_CHANNELS=True

# ==========================================
# CELERY WORKER
# ==========================================
# Tareas I/O-bound (DB + email): 4 workers cubre las 19 tareas periódicas.
# Bajar a 2 en servidores con <4 GB RAM; subir a 8 si el servidor lo aguanta.
CELERY_CONCURRENCY=4

# ==========================================
# BANCARD — Pagos con tarjeta Visa/Mastercard
# ==========================================
# BANCARD_SANDBOX=False en producción (production.py lo fuerza de todas formas)
BANCARD_SANDBOX=False
BANCARD_PUBLIC_KEY=<PUBLIC_KEY_DE_BANCARD>
BANCARD_PRIVATE_KEY=<PRIVATE_KEY_DE_BANCARD>
BANCARD_MERCHANT_ID=<MERCHANT_ID_DE_BANCARD>
BANCARD_RETURN_URL=https://cantinatita.com/api/v1/bancard/retorno/
BANCARD_CANCEL_URL=https://cantinatita.com/pago/cancelado

# ==========================================
# SENTRY — Monitoreo de errores
# ==========================================
# Plan gratuito: 5.000 errores/mes — suficiente para este volumen.
# Crear DOS proyectos en sentry.io: uno Django y uno React.
# DSN en: Settings → Projects → <proyecto> → Client Keys (DSN)

SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.05

# DSN del proyecto React — deploy.ps1 lo pasa como build arg VITE_SENTRY_DSN
SENTRY_DSN_FRONTEND=https://<key2>@<org>.ingest.sentry.io/<project2>

# ==========================================
# WEB PUSH (VAPID) — Notificaciones push PWA
# ==========================================
# Generar claves con: pip install pywebpush && vapid --applicationServerKey

VAPID_PUBLIC_KEY=<BASE64URL_PUBLIC_KEY>
VAPID_PRIVATE_KEY=<BASE64URL_PRIVATE_KEY>
VAPID_ADMIN_EMAIL=admin@cantinatita.com

# ==========================================
# PORTAL DE PADRES
# ==========================================

# URL pública del frontend — usada por bancard_views.py para redirigir
# al portal tras el pago (retorno/cancelación desde Bancard)
PORTAL_FRONTEND_URL=https://cantinatita.com

# ==========================================
# WHATSAPP (WAHA — self-hosted)
# ==========================================
# WAHA corre como servicio Docker en el mismo servidor.
# WAHA_API_KEY también debe estar en el .env raíz del proyecto
# (D:\tita2026\.env) para que docker-compose lo inyecte en el contenedor WAHA.

EVOLUTION_API_URL=http://waha:3000
EVOLUTION_API_KEY=<WAHA_API_KEY>
EVOLUTION_API_INSTANCE=default
NOTIFICACIONES_ACTIVAS=True

# ==========================================
# PROMETHEUS PUSHGATEWAY
# ==========================================

PUSHGATEWAY_URL=http://pushgateway:9091

# ==========================================
# GRAFANA
# ==========================================
# Contraseña del admin de Grafana.
# También debe estar en D:\tita2026\.env como GRAFANA_PASSWORD=<valor>

GRAFANA_PASSWORD=<GRAFANA_ADMIN_PASSWORD>
