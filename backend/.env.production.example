# ==========================================
# CANTINA TITA - PRODUCTION ENVIRONMENT
# ==========================================
# Copy this file to .env and fill with real values
# DO NOT commit .env to git!

# ==========================================
# DJANGO CORE
# ==========================================

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=RznXrhcUewXXf_hyaMZpOdfVfAI6hIE2cB5q7ERa6YPSkNsj0gkuB_gA8xNL2M6Zm7w

# Django settings module
DJANGO_SETTINGS_MODULE=backend.settings.production

# Debug mode (ALWAYS False in production)
DEBUG=False

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=cantina-tita.com,www.cantina-tita.com,api.cantina-tita.com

# CSRF trusted origins (comma-separated with https://)
CSRF_TRUSTED_ORIGINS=https://cantina-tita.com,https://www.cantina-tita.com

# CORS allowed origins (comma-separated with https://)
CORS_ALLOWED_ORIGINS=https://cantina-tita.com,https://www.cantina-tita.com

# ==========================================
# DATABASE (SQL SERVER)
# ==========================================

DB_HOST=localhost
DB_PORT=1433
DB_NAME=titadb
DB_USER=cantina_user
DB_PASSWORD=<STRONG_PASSWORD_HERE>

# ==========================================
# EMAIL CONFIGURATION
# ==========================================

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@cantina-tita.com
EMAIL_HOST_PASSWORD=<EMAIL_PASSWORD_HERE>
DEFAULT_FROM_EMAIL=noreply@cantina-tita.com
ADMIN_EMAIL=admin@cantina-tita.com

# ==========================================
# REDIS (OPTIONAL - for caching)
# ==========================================

REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=<REDIS_PASSWORD_HERE>

# ==========================================
# SENTRY (OPTIONAL - for error tracking)
# ==========================================

SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
GIT_COMMIT_SHA=$(git rev-parse HEAD)

# ==========================================
# CELERY (OPTIONAL - for async tasks)
# ==========================================

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ==========================================
# AWS S3 (OPTIONAL - for media files)
# ==========================================

# AWS_ACCESS_KEY_ID=<YOUR_KEY>
# AWS_SECRET_ACCESS_KEY=<YOUR_SECRET>
# AWS_STORAGE_BUCKET_NAME=cantina-tita-media
# AWS_S3_REGION_NAME=us-east-1

# ==========================================
# MONITORING (OPTIONAL)
# ==========================================

# GRAFANA_API_KEY=<YOUR_KEY>
# PROMETHEUS_ENDPOINT=http://localhost:9090
