[flake8]
max-line-length = 120
extend-ignore = E203, W503, E501, W293, W291, E722, E731, C901, E712, E402, F541, F841, E303, W391, F811
exclude = 
    migrations,
    __pycache__,
    venv,
    .venv,
    env,
    .env,
    htmlcov,
    .coverage,
    *.pyc,
    .git,
    __init__.py

per-file-ignores =
    # Allow star imports and unused imports in __init__ files
    __init__.py:F401,F403,F405
    # Settings files use intentional star imports (Django pattern)
    backend/settings/*.py:F401,F403,F405
    settings/*.py:F401,F403,F405
    # Test files commonly import symbols for use in assertions / fixtures
    tests.py:F401,F403,F405,F811,F841
    tests_*.py:F401,F403,F405,F811,F841
    *_test.py:F401,F403,F405,F811,F841

# Complexity
max-complexity = 15
