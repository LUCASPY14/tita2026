# ====================================
# Production Environment Variables
# Cantina Tita - Secure Production Configuration
# ====================================

# Application Version
APP_VERSION=1.0.0
TAG=latest
BUILD_DATE=2026-03-06T00:00:00Z
VCS_REF=main

# ================================
# DJANGO CONFIGURATION
# ================================
DJANGO_SECRET_KEY=your-super-secure-secret-key-change-this-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,cantina-tita.com,www.cantina-tita.com
DJANGO_SETTINGS_MODULE=backend.settings.production

# Security Settings
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ================================
# DATABASE CONFIGURATION
# ================================
DB_NAME=titadb
DB_USER=sa
DB_PASSWORD=generate-secure-password-here
DB_HOST=db
DB_PORT=1433
MSSQL_SA_PASSWORD=generate-secure-password-here
MSSQL_PID=Developer

# ================================
# REDIS CONFIGURATION
# ================================
REDIS_PASSWORD=generate-secure-redis-password-here
REDIS_PORT=6379

# ================================
# EMAIL CONFIGURATION
# ================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@cantina-tita.com
EMAIL_HOST_PASSWORD=your-email-app-password

# ================================
# FILE STORAGE (AWS S3)
# ================================
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=cantina-tita-media
AWS_S3_REGION_NAME=us-east-1

# ================================
# MONITORING & LOGGING
# ================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=secure-grafana-password
GRAFANA_PORT=3001

# Prometheus
PROMETHEUS_PORT=9090

# ================================
# APPLICATION CONFIGURATION
# ================================
# Frontend
FRONTEND_PORT=80
REACT_APP_API_URL=/api
API_URL=/api

# Backend 
BACKEND_PORT=8000

# ================================
# SUPERUSER CONFIGURATION
# ================================
CREATE_SUPERUSER=true
SUPERUSER_EMAIL=admin@cantina-tita.com
SUPERUSER_PASSWORD=change-this-secure-admin-password

# ================================
# SSL/TLS CONFIGURATION
# ================================
ACME_EMAIL=admin@cantina-tita.com

# ================================
# PERFORMANCE SETTINGS
# ================================
# Worker processes
GUNICORN_WORKERS=4
GUNICORN_MAX_REQUESTS=1000
GUNICORN_TIMEOUT=30

# Cache settings
CACHE_TTL=300
API_CACHE_TTL=600

# ================================
# BACKUP CONFIGURATION
# ================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# ================================
# DEVELOPMENT OVERRIDES
# (Comment out for production)
# ================================
# DEBUG=True
# DJANGO_ALLOWED_HOSTS=*
# SECURE_SSL_REDIRECT=False