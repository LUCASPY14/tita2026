# ====================================
# Multi-stage Production Dockerfile for React Frontend
# ====================================

# =====================================
# Stage 1: Build the application
# =====================================
FROM node:20-alpine as builder

# Set environment variables for build optimization
ENV NODE_ENV=production \
    CI=true \
    GENERATE_SOURCEMAP=false

# Install dependencies for build (including Python for node-gyp)
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    && rm -rf /var/cache/apk/*

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies with npm ci for faster, more reliable builds
RUN npm ci --only=production --ignore-scripts && \
    npm cache clean --force

# Copy source code
COPY . .

# Build the application
RUN npm run build && \
    # Remove development dependencies and source code to reduce size
    rm -rf src/ public/ node_modules/ && \
    # Keep only the built application
    ls -la build/

# =====================================
# Stage 2: Production server with Nginx
# =====================================
FROM nginx:1.25-alpine as production

# Install security updates and utilities
RUN apk add --no-cache \
    curl \
    tini \
    && rm -rf /var/cache/apk/*

# Create non-root user for nginx
RUN adduser -D -s /bin/sh www-data

# Copy built application from builder stage
COPY --from=builder /app/build /usr/share/nginx/html

# Copy custom Nginx configuration
COPY docker/frontend/nginx.prod.conf /etc/nginx/nginx.conf
COPY docker/frontend/default.prod.conf /etc/nginx/conf.d/default.conf

# Copy security headers configuration
COPY docker/frontend/security-headers.conf /etc/nginx/conf.d/security-headers.conf

# Create log directories
RUN mkdir -p /var/log/nginx && \
    chown -R www-data:www-data /var/log/nginx /usr/share/nginx/html

# Copy and set permissions for entrypoint script
COPY docker/frontend/entrypoint.prod.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:80/health || exit 1

# Expose port
EXPOSE 80

# Use tini as init system
ENTRYPOINT ["/sbin/tini", "--", "/entrypoint.sh"]

# Default command
CMD ["nginx", "-g", "daemon off;"]

# =====================================
# Stage 3: Development image with hot reload
# =====================================
FROM node:20-alpine as development

# Set development environment
ENV NODE_ENV=development

# Install dependencies
RUN apk add --no-cache \
    git \
    curl \
    && rm -rf /var/cache/apk/*

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies including dev dependencies
RUN npm install

# Copy source code
COPY . .

# Expose port
EXPOSE 3000

# Health check for development
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3000 || exit 1

# Development command with hot reload
CMD ["npm", "start"]

# =====================================
# Stage 4: Testing image
# =====================================
FROM development as testing

# Install testing dependencies
RUN npm install --save-dev @testing-library/jest-dom

# Copy test configuration
COPY cypress.config.ts ./
COPY cypress/ ./cypress/

# Install Cypress dependencies
RUN apk add --no-cache \
    gtk+3.0-dev \
    libnotify-dev \
    gconf-service \
    libasound2-dev \
    libatk1.0-dev \
    libc6-dev \
    libcairo-gobject2 \
    libdrm2 \
    libgtk-3-0 \
    libgtkcommon \
    libnss3-dev \
    libx11-xcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxi6 \
    libxtst6 \
    libxrandr2 \
    libasound2 \
    libpangocairo-1.0-0 \
    libcairo-gobject2 \
    fonts-liberation \
    && rm -rf /var/cache/apk/*

# Install Cypress
RUN npx cypress install

# Default testing command
CMD ["npm", "test"]