# ===========================================
# CONFIGURACIÓN DOCKER - CANTINA TITA
# ===========================================

# Django Settings
DJANGO_SETTINGS_MODULE=backend.settings.docker
SECRET_KEY=django-insecure-docker-dev-key-change-in-production-abc123xyz
DEBUG=True

# Database (SQL Server)
DB_ENGINE=mssql
DB_NAME=titadb
DB_USER=sa
DB_PASSWORD=ChangeThis_StrongPassw0rd!
DB_HOST=db
DB_PORT=1433
MSSQL_SA_PASSWORD=ChangeThis_StrongPassw0rd!
MSSQL_PID=Developer

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Email (Development - Console)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ALLOWED_HOSTS (separados por coma, sin espacios)
# Incluye tu IP local para que otras PCs puedan acceder
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,192.168.1.*

# CORS Origins (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://192.168.1.1:80

# API Base URL
VITE_API_URL=http://localhost:8000/api/v1

# Timezone
TZ=America/Asuncion

# ===========================================
# INSTRUCCIONES:
# 1. Copia este archivo como .env en la raíz del proyecto
# 2. Ajusta ALLOWED_HOSTS con tu IP local (ejemplo: 192.168.1.100)
# 3. Ajusta CORS_ALLOWED_ORIGINS según sea necesario
# 4. NO subas este archivo a Git (ya está en .gitignore)
# ===========================================
